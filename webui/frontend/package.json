{
  "name": "iec104-tester-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "IEC104 Tester Web UI (Vite + React 18 + TypeScript + Ant Design 5)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
