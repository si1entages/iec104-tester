{
  "name": "iec104-tester-webui",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "description": "IEC104 Tester Web UI (Vite + React 19 + TypeScript 7 + Ant Design 6)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --testTimeout=120000 --hookTimeout=120000",
    "test:watch": "vitest",
    "i18n:inventory": "node scripts/i18n-inventory.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@carbon/react": "^1.120.0",
    "@carbon/styles": "^1.119.0",
    "@patternfly/patternfly": "^6.7.0",
    "@patternfly/react-core": "^6.7.0",
    "@patternfly/react-icons": "^6.7.0",
    "@patternfly/react-table": "^6.7.0",
    "@tanstack/react-query": "^5.106.0",
    "@tanstack/react-virtual": "^3.14.26",
    "antd": "^6.7.0",
    "echarts": "^6.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
